# Neon Postgres connection string. Leave empty locally to use the embedded PGlite database (./.pglite)
DATABASE_URL=

# Long random string used to sign login sessions (e.g. run: npx auth secret, or any 32+ char random string)
AUTH_SECRET=

# Code people must enter to create an account (share only with BOBA 80s executives)
SIGNUP_ACCESS_CODE=
